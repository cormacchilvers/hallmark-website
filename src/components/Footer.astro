---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">

      <!-- Brand -->
      <div>
        <a href="/" class="footer-logo" aria-label="Hallmark Studio, home">
          <span class="logo-hallmark">Hallmark</span>
          <span class="logo-studio">Studio</span>
        </a>
        <p class="footer__desc">
          Web design and SEO for Essex small businesses. Based in Chelmsford.
        </p>
      </div>

      <!-- Services -->
      <div>
        <p class="footer__heading">Services</p>
        <ul class="footer__list" role="list">
          <li><a href="/web-design">Web Design</a></li>
          <li><a href="/seo">SEO & Google</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/free-audit">Free Audit</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <p class="footer__heading">Company</p>
        <ul class="footer__list" role="list">
          <li><a href="/about">About Us</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="footer__heading">Get in Touch</p>
        <ul class="footer__list" role="list">
          <li><a href="tel:07570947291">07570 947291</a></li>
          <li><a href="mailto:hello@hallmarkstudio.com">hello@hallmarkstudio.com</a></li>
          <li><a href="https://calendly.com/d/cx5p-3yv-z9y/free-discovery-call" target="_blank" rel="noopener noreferrer">Book a Call</a></li>
          <li style="margin-top:.75rem; display:flex; gap:.75rem; flex-wrap:wrap;">
            <a href="https://www.linkedin.com/company/hallmarkstudio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">LinkedIn</a>
            <a href="https://www.instagram.com/hallmarkstudio.web" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
            <a href="https://www.x.com/byhallmark" target="_blank" rel="noopener noreferrer" aria-label="X / Twitter">X</a>
            <a href="https://www.tiktok.com/@hallmark.studio" target="_blank" rel="noopener noreferrer" aria-label="TikTok">TikTok</a>
          </li>
        </ul>
      </div>

    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">© {year} Hallmark Studio. All rights reserved. Registered in England &amp; Wales.</p>
      <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:center;">
        <p class="footer__copyright">Chelmsford, Essex, UK</p>
        <a href="/privacy" style="font-size:.8125rem; color:rgba(255,255,255,.55); transition:color var(--t);">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>
