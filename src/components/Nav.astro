---
const pathname = Astro.url.pathname;

const links = [
  { href: '/web-design', label: 'Web Design' },
  { href: '/seo',        label: 'SEO' },
  { href: '/pricing',    label: 'Pricing' },
  { href: '/about',      label: 'About' },
  { href: '/blog',       label: 'Blog' },
];
---

<nav id="site-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="Hallmark Studio, home">
      <span class="nav-logo__top">Hallmark</span>
      <span class="nav-logo__sub">Studio</span>
    </a>

    <!-- Desktop links -->
    <ul class="nav-links" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['nav-link', { 'nav-link--active': pathname.startsWith(href) }]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Phone -->
    <a href="tel:07570947291" class="nav-phone" aria-label="Call us: 07570 947291">
      07570 947291
    </a>

    <!-- Desktop CTA -->
    <a href="/free-audit" class="nav-cta">Get Free Audit</a>

    <!-- Mobile hamburger -->
    <button id="nav-toggle" class="nav-hamburger" aria-expanded="false" aria-controls="nav-drawer" aria-label="Open navigation menu">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <rect x="1" y="5"  width="20" height="2" rx="1" fill="currentColor"/>
        <rect x="1" y="10" width="20" height="2" rx="1" fill="currentColor"/>
        <rect x="1" y="15" width="20" height="2" rx="1" fill="currentColor"/>
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div id="nav-drawer" class="nav-drawer" aria-hidden="true">
    <nav class="nav-drawer__links">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={['nav-drawer__link', { 'nav-drawer__link--active': pathname.startsWith(href) }]}
        >
          {label}
        </a>
      ))}
      <a href="/free-audit" class="nav-drawer__cta">Get a Free 15-Minute Audit</a>
    </nav>
  </div>
</nav>

<style>
  #site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    height: 72px;
    transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  #site-nav.is-scrolled {
    background: rgba(12, 27, 51, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.25rem;
  }

  .nav-logo {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    line-height: 1;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-logo__top {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: #fff;
    text-transform: uppercase;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
  .nav-logo__sub {
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.48em;
    color: rgba(255,255,255,.5);
    text-transform: uppercase;
    font-family: 'Instrument Sans', system-ui, sans-serif;
  }

  .nav-links {
    display: none;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    align-items: center;
  }

  .nav-link {
    display: flex;
    align-items: center;
    height: 72px;
    padding: 0 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.72);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nav-link:hover,
  .nav-link--active { color: #fff; }

  .nav-phone {
    display: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
    padding: 0 1.25rem;
    border-right: 1px solid rgba(255,255,255,0.1);
    margin-right: 0.5rem;
    transition: color 0.15s;
  }
  .nav-phone:hover { color: #6c63d4; }

  .nav-cta {
    display: none;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border-radius: 10px;
    background: #6c63d4;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
    transition: background 0.15s;
  }
  .nav-cta:hover { background: #5a52b8; }

  .nav-hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    padding: 0.5rem;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .nav-hamburger:hover { background: rgba(255,255,255,0.1); }

  /* Mobile drawer */
  .nav-drawer {
    position: fixed;
    top: 0; right: 0;
    width: 288px;
    height: 100dvh;
    background: #1a1636;
    border-left: 1px solid rgba(255,255,255,0.1);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 49;
    padding-top: 64px;
  }
  .nav-drawer.is-open {
    transform: translateX(0);
  }
  .nav-drawer__links {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.25rem 0;
  }
  .nav-drawer__link {
    display: block;
    padding: 0.875rem 1rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: rgba(255,255,255,0.78);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    transition: color 0.15s;
    font-family: Inter, system-ui, sans-serif;
  }
  .nav-drawer__link:hover,
  .nav-drawer__link--active { color: #fff; }
  .nav-drawer__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1rem;
    padding: 0.875rem 1.25rem;
    border-radius: 10px;
    background: #6c63d4;
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background 0.15s;
    font-family: Inter, system-ui, sans-serif;
  }
  .nav-drawer__cta:hover { background: #5a52b8; }

  @media (min-width: 768px) {
    .nav-phone { display: block; }
  }
  @media (min-width: 1024px) {
    .nav-inner { padding: 0 2.5rem; }
    .nav-links { display: flex; }
    .nav-phone { display: block; }
    .nav-cta { display: inline-flex; }
    .nav-hamburger { display: none; }
  }
</style>

<script>
  // Scroll transparency
  const nav = document.getElementById('site-nav');
  function updateScroll() {
    nav?.classList.toggle('is-scrolled', window.scrollY > 40);
  }
  updateScroll();
  window.addEventListener('scroll', updateScroll, { passive: true });

  // Mobile drawer
  const toggle = document.getElementById('nav-toggle');
  const drawer = document.getElementById('nav-drawer');
  toggle?.addEventListener('click', () => {
    const isOpen = drawer?.classList.contains('is-open');
    drawer?.classList.toggle('is-open', !isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    drawer?.setAttribute('aria-hidden', String(isOpen));
  });

  // Close on link click
  drawer?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      drawer.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
    });
  });
</script>
