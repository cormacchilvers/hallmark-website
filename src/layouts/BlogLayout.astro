---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  tags?: string[];
  canonical?: string;
}

const { title, description, pubDate, author, tags = [], canonical } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});

const articleSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    affiliation: { '@type': 'Organization', name: 'Hallmark Studio' },
  },
  publisher: {
    '@type': 'Organization',
    name: 'Hallmark Studio',
    url: 'https://www.hallmarkstudio.com',
  },
});
---

<Layout
  title={`${title} | Hallmark Studio`}
  description={description}
  canonical={canonical}
  schemaExtra={articleSchema}
>
  <!-- Page header -->
  <div class="page-header">
    <div class="container container--narrow">
      <span class="label">Hallmark Studio Blog</span>
      <h1>{title}</h1>
      <p class="page-header__sub" style="margin-top:.5rem;">
        {formattedDate} &nbsp;·&nbsp; {author}
      </p>
    </div>
  </div>

  <!-- Article body -->
  <article style="padding-block:4.5rem 3rem;">
    <div class="container container--narrow">
      <div class="prose">
        <slot />
      </div>

      <!-- CTA -->
      <div style="margin-top:3.5rem; padding-top:2.5rem; border-top:1px solid var(--border);">
        <p class="label">Free audit</p>
        <h3 style="margin-bottom:.75rem;">Want to know what's holding your business back?</h3>
        <p style="color:var(--text-muted); font-size:.9375rem; max-width:52ch;">
          We offer a free 15-minute audit of your website and Google listing.
          Honest feedback, no pitch.
        </p>
        <a href="/free-audit" class="btn btn--amber" style="margin-top:1.25rem;">
          Get My Free Audit
        </a>
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="areas" style="margin-top:2.5rem;">
          {tags.map(t => <span class="area-chip">{t}</span>)}
        </div>
      )}

      <!-- Back link -->
      <a href="/blog" style="display:inline-flex; align-items:center; gap:.5rem; margin-top:2rem; font-size:.875rem; font-weight:600; color:var(--navy);">
        ← All posts
      </a>
    </div>
  </article>
</Layout>
